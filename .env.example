# Copy to .env and fill in. Never commit the real file.
# Pooled Supabase connection (pooler, port 6543) preferred.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# Fallback direct connection (port 5432).
DIRECT_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Optional tuning
RENTECH_DATA_DIR=data
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
